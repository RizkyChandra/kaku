# Copy to .env for local development. Loaded by `make dev`.

KAKU_ENV=development
KAKU_ADDR=:8080
KAKU_URL=http://localhost:8080
KAKU_DB_PATH=./data/kaku.db

# Owner account, created on first boot. Required unless the database already has users.
KAKU_ROOT_EMAIL=you@example.com
KAKU_ROOT_PASSWORD=change-me-please

# Media storage. These defaults point at the gofakes3 server `make dev` starts.
KAKU_S3_ENDPOINT=http://localhost:9000
KAKU_S3_REGION=us-east-1
KAKU_S3_BUCKET=kaku
KAKU_S3_ACCESS_KEY=kaku
KAKU_S3_SECRET_KEY=kakukaku
KAKU_S3_PUBLIC_URL=http://localhost:9000/kaku
