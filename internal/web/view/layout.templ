package view

import (
	"github.com/RizkyChandra/kaku/internal/db"
	"github.com/RizkyChandra/kaku/internal/i18n"
)

// Page carries what every admin screen needs from the chrome around it.
type Page struct {
	Title  string
	User   *db.User
	Active string // nav key of the current section
	// SiteTitle and Footer come from the settings table, so the operator's own
	// name for the site appears in the admin rather than just "Kaku".
	SiteTitle string
	Footer    string
	// Lang, Locales and Path drive the language picker.
	Lang    string
	Locales []i18n.Locale
	Path    string
}

func (p Page) langOr(def string) string {
	if p.Lang != "" {
		return p.Lang
	}
	return def
}

func (p Page) siteName() string {
	if p.SiteTitle != "" {
		return p.SiteTitle
	}
	return "Kaku"
}

type navItem struct {
	Key, Href, Label string
}

// Label is a message key; the text is resolved per request from the context.
var nav = []navItem{
	{"posts", "/admin/posts", "nav.posts"},
	{"pages", "/admin/pages", "nav.pages"},
	{"search", "/admin/search", "nav.search"},
	{"tags", "/admin/tags", "nav.tags"},
	{"media", "/admin/media", "nav.media"},
	{"users", "/admin/users", "nav.users"},
	{"keys", "/admin/keys", "nav.keys"},
	{"settings", "/admin/settings", "nav.settings"},
}

templ head(title string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="robots" content="noindex, nofollow"/>
	<title>{ title } &middot; Kaku</title>
	<link rel="icon" href={ asset("logo.svg") }/>
	<link rel="stylesheet" href={ asset("tailwind.css") }/>
	<script src={ asset("htmx.min.js") } defer></script>
}

// Shell is the signed-in admin chrome: fixed sidebar, scrolling content.
templ Shell(p Page) {
	<!DOCTYPE html>
	<html lang={ p.langOr("en") } class="h-full">
		<head>
			@head(p.Title)
		</head>
		<body class="h-full bg-ink-50 text-ink-900 font-sans antialiased">
			<div class="flex h-full">
				<aside class="hidden w-56 shrink-0 flex-col border-r border-ink-200 bg-surface md:flex">
					<a href="/admin" class="flex items-baseline gap-2 px-6 py-6">
						<span class="font-serif text-2xl leading-none text-vermilion">書</span>
						<span class="truncate font-serif text-xl leading-none">{ p.siteName() }</span>
					</a>
					<nav class="flex-1 px-3">
						for _, item := range nav {
							@navLink(item, p.Active)
						}
					</nav>
					@languagePicker(p)
					@sidebarFooter(p.User)
				</aside>
				<main class="min-w-0 flex-1 overflow-y-auto">
					<div class="mx-auto max-w-5xl px-6 py-8 md:px-10">
						{ children... }
						if p.Footer != "" {
							<footer class="mt-12 border-t border-ink-200 pt-4 text-xs text-ink-400">{ p.Footer }</footer>
						}
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ navLink(item navItem, active string) {
	if item.Key == active {
		<a
			href={ templ.SafeURL(item.Href) }
			class="mb-0.5 flex items-center rounded-md border-l-2 border-vermilion bg-ink-100 px-3 py-2 text-sm font-medium"
			aria-current="page"
		>{ i18n.T(ctx, item.Label) }</a>
	} else {
		<a
			href={ templ.SafeURL(item.Href) }
			class="mb-0.5 flex items-center rounded-md border-l-2 border-transparent px-3 py-2 text-sm text-ink-600 hover:bg-ink-50 hover:text-ink-900"
		>{ i18n.T(ctx, item.Label) }</a>
	}
}

// languagePicker submits on change, so it needs no JavaScript of our own. It is
// rendered even with a single locale loaded, which is the cue that dropping a
// file into KAKU_LOCALES_DIR is how you add one.
templ languagePicker(p Page) {
	<form method="post" action="/admin/language" class="border-t border-ink-200 px-6 py-3">
		<input type="hidden" name="next" value={ p.Path }/>
		<label class="block text-xs text-ink-400" for="lang">{ i18n.T(ctx, "nav.language") }</label>
		<select
			id="lang"
			name="lang"
			onchange="this.form.submit()"
			class="mt-1 w-full rounded-md border border-ink-200 bg-surface px-2 py-1 text-sm focus:border-vermilion focus:outline-none"
		>
			for _, l := range p.Locales {
				<option value={ l.Code } selected?={ l.Code == p.Lang }>{ l.Name }</option>
			}
		</select>
		<noscript>
			<button type="submit" class="mt-2 text-xs underline underline-offset-2">{ i18n.T(ctx, "nav.language") }</button>
		</noscript>
	</form>
}

templ sidebarFooter(u *db.User) {
	if u != nil {
		<div class="border-t border-ink-200 px-6 py-4">
			<p class="truncate text-sm font-medium">{ u.Name }</p>
			<p class="truncate text-xs text-ink-400">{ u.Role }</p>
			<form method="post" action="/admin/logout" class="mt-2">
				<button type="submit" class="text-xs text-ink-400 underline underline-offset-2 hover:text-vermilion">{ i18n.T(ctx, "nav.signOut") }</button>
			</form>
		</div>
	}
}

// PageHeader is the title row every screen opens with.
templ PageHeader(title string) {
	<header class="mb-8 flex items-center justify-between gap-4">
		<h1 class="font-serif text-3xl">{ title }</h1>
		<div class="flex items-center gap-2">
			{ children... }
		</div>
	</header>
}
