package view

import (
	"fmt"
	"html"
	"net/url"
	"strconv"
	"strings"

	"github.com/RizkyChandra/kaku/internal/i18n"
)

// SearchRow is one hit. sqlc generates its own row type, so the handler
// flattens into this, as the post list does.
type SearchRow struct {
	ID      int64
	Title   string
	Status  string
	Author  string
	Excerpt string
	Snippet string // matching body text, matches wrapped in [[hl]] markers
}

type SearchResults struct {
	Query string
	Page  int
	Pages int
	Rows  []SearchRow
}

// Href links to this search at page n, keeping the query.
func (res SearchResults) Href(n int) string {
	v := url.Values{"q": {res.Query}}
	if n > 1 {
		v.Set("page", strconv.Itoa(n))
	}
	return "/admin/search?" + v.Encode()
}

// highlighted is the snippet as markup. The order is load-bearing: the snippet
// is post body text, which anyone who can write a post controls, so it is
// escaped first and only then are the markers swapped for tags. EscapeString
// leaves the markers alone — that is why they hold no escapable character —
// so they still match. Doing it the other way round would escape the <mark>
// tags, and skipping the escape would run the post's own HTML.
func (row SearchRow) highlighted() string {
	s := html.EscapeString(row.Snippet)
	s = strings.ReplaceAll(s, "[[hl]]", `<mark class="rounded bg-vermilion/10 px-1 font-medium text-vermilion-dark">`)
	return strings.ReplaceAll(s, "[[/hl]]", "</mark>")
}

templ Search(p Page, res SearchResults) {
	@Shell(p) {
		@PageHeader(i18n.T(ctx, "search.title")) {
		}
		<form role="search" method="get" action="/admin/search" class="mb-6">
			<label class="block text-sm font-medium" for="q">{ i18n.T(ctx, "search.label") }</label>
			<div class="mt-1 flex gap-2">
				<input
					id="q"
					name="q"
					type="search"
					value={ res.Query }
					autocomplete="off"
					placeholder={ i18n.T(ctx, "search.placeholder") }
					hx-get="/admin/search"
					hx-trigger="input changed delay:300ms, search"
					hx-target="#results"
					class="w-full max-w-md rounded-md border border-ink-200 px-3 py-2 focus:border-vermilion focus:outline-none"
				/>
				<button type="submit" class="rounded-md bg-vermilion px-3 py-2 text-sm font-medium text-white hover:bg-vermilion-dark">
					{ i18n.T(ctx, "search.submit") }
				</button>
			</div>
		</form>
		<div id="results" aria-live="polite">
			@SearchHits(res)
		</div>
	}
}

// SearchHits is the fragment the type-ahead swaps in, and the same markup the
// full page ships with JavaScript off.
templ SearchHits(res SearchResults) {
	if res.Query == "" {
		<p class="text-ink-600">{ i18n.T(ctx, "search.prompt") }</p>
	} else if len(res.Rows) == 0 {
		<p class="text-ink-600">{ i18n.T(ctx, "search.empty", res.Query) }</p>
	} else {
		<ul class="divide-y divide-ink-100 overflow-hidden rounded-lg border border-ink-200 bg-white">
			for _, row := range res.Rows {
				<li class="p-4">
					<div class="flex items-baseline justify-between gap-3">
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/posts/%d", row.ID)) }
							class="font-medium hover:text-vermilion"
						>{ row.Title }</a>
						@statusBadge(row.Status)
					</div>
					<p class="mt-0.5 text-xs text-ink-400">{ row.Author }</p>
					if row.Snippet != "" {
						<p class="mt-1 text-sm text-ink-600">@templ.Raw(row.highlighted())</p>
					} else if row.Excerpt != "" {
						<p class="mt-1 text-sm text-ink-600">{ row.Excerpt }</p>
					}
				</li>
			}
		</ul>
		@searchPager(res)
	}
}

templ searchPager(res SearchResults) {
	if res.Pages > 1 {
		<nav class="mt-4 flex items-center justify-between text-sm" aria-label={ i18n.T(ctx, "search.pagination") }>
			if res.Page > 1 {
				<a href={ templ.SafeURL(res.Href(res.Page - 1)) } class="text-ink-600 hover:text-vermilion">← { i18n.T(ctx, "search.newer") }</a>
			} else {
				<span></span>
			}
			<span class="text-ink-400">{ i18n.T(ctx, "search.pager", res.Page, res.Pages) }</span>
			if res.Page < res.Pages {
				<a href={ templ.SafeURL(res.Href(res.Page + 1)) } class="text-ink-600 hover:text-vermilion">{ i18n.T(ctx, "search.older") } →</a>
			} else {
				<span></span>
			}
		</nav>
	}
}
