package view

templ Dashboard(p Page) {
	@Shell(p) {
		@PageHeader("Dashboard") {
			<a href="/admin/posts/new" class="rounded-md bg-vermilion px-3 py-2 text-sm font-medium text-white hover:bg-vermilion-dark">New post</a>
		}
		<div class="rounded-lg border border-ink-200 bg-white p-8">
			<p class="font-serif text-xl">書く — to write.</p>
			<p class="mt-2 max-w-prose text-ink-600">
				Kaku stores your writing as markdown and serves it over a read-only
				Content API. Start with a post, or point a reader at
				<code class="rounded bg-ink-100 px-1 py-0.5 text-sm">/api/v1/posts</code>.
			</p>
		</div>
	}
}
