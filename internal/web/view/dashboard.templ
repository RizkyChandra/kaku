package view

import (
	"context"
	"fmt"

	"github.com/RizkyChandra/kaku/internal/i18n"
)

// Stat is one number on the dashboard. Href makes it a link when the count is
// worth acting on.
type Stat struct {
	Label string
	Count int64
	Href  string
}

type DashboardData struct {
	Stats  []Stat
	Recent []PostRow
	// Needs is the drafts-and-scheduled line, the thing an author actually
	// came to check.
	Drafts    int64
	Scheduled int64
}

templ Dashboard(p Page, d DashboardData) {
	@Shell(p) {
		@PageHeader(i18n.T(ctx, "dashboard.title")) {
			<a href="/admin/posts/new" class="rounded-md bg-vermilion px-3 py-2 text-sm font-medium text-white hover:bg-vermilion-dark">{ i18n.T(ctx, "dashboard.newPost") }</a>
		}
		<dl class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
			for _, s := range d.Stats {
				@statTile(s)
			}
		</dl>
		if d.Drafts > 0 || d.Scheduled > 0 {
			<p class="mb-8 rounded-lg border border-ink-200 bg-white px-4 py-3 text-sm text-ink-600">
				{ needsAttention(ctx, d.Drafts, d.Scheduled) }
				<a href="/admin/posts?status=draft" class="ml-1 text-vermilion underline underline-offset-2">{ i18n.T(ctx, "dashboard.review") }</a>
			</p>
		}
		<section class="rounded-lg border border-ink-200 bg-white">
			<h2 class="border-b border-ink-200 px-5 py-3 font-serif text-lg">{ i18n.T(ctx, "dashboard.recent") }</h2>
			if len(d.Recent) == 0 {
				<p class="px-5 py-6 text-ink-600">
					{ i18n.T(ctx, "dashboard.empty") } <a href="/admin/posts/new" class="text-vermilion underline underline-offset-2">{ i18n.T(ctx, "dashboard.start") }</a>
				</p>
			} else {
				<ul>
					for _, row := range d.Recent {
						<li class="border-b border-ink-100 last:border-0">
							<a href={ templ.SafeURL(fmt.Sprintf("/admin/posts/%d", row.ID)) } class="flex items-baseline justify-between gap-4 px-5 py-3 hover:bg-ink-50">
								<span class="min-w-0 truncate">{ row.Title }</span>
								<span class="shrink-0 text-xs text-ink-400">{ row.Status } &middot; { row.Author }</span>
							</a>
						</li>
					}
				</ul>
			}
		</section>
	}
}

templ statTile(s Stat) {
	<div class="rounded-lg border border-ink-200 bg-white px-4 py-3">
		<dt class="text-xs text-ink-400">{ i18n.T(ctx, s.Label) }</dt>
		<dd class="mt-0.5 font-serif text-2xl">
			if s.Href != "" {
				<a href={ templ.SafeURL(s.Href) } class="hover:text-vermilion">{ fmt.Sprint(s.Count) }</a>
			} else {
				{ fmt.Sprint(s.Count) }
			}
		</dd>
	</div>
}

// Pluralisation and word order both belong to the locale, so this composes
// whole translated clauses rather than gluing an "s" onto an English noun.
func needsAttention(ctx context.Context, drafts, scheduled int64) string {
	switch {
	case drafts > 0 && scheduled > 0:
		return i18n.T(ctx, "dashboard.bothWaiting",
			i18n.N(ctx, "dashboard.draftsWaiting", drafts),
			i18n.N(ctx, "dashboard.scheduledWaiting", scheduled))
	case drafts > 0:
		return i18n.N(ctx, "dashboard.draftsWaiting", drafts)
	default:
		return i18n.N(ctx, "dashboard.scheduledWaiting", scheduled)
	}
}
