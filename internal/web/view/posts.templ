package view

import (
	"fmt"
	"net/url"
	"strconv"
	"time"
)

// PostRow is one line of the list. sqlc generates a separate row type per
// query, so the handler flattens both into this.
type PostRow struct {
	ID     int64
	Title  string
	Slug   string
	Status string
	Author string
	At     time.Time
}

// PostList is a page of posts or pages, filtered by status.
type PostList struct {
	Type   string // "post" or "page"
	Status string // "" for every status
	Page   int
	Pages  int
	Rows   []PostRow
}

func (l PostList) Base() string {
	if l.Type == "page" {
		return "/admin/pages"
	}
	return "/admin/posts"
}

func (l PostList) NewHref() string {
	if l.Type == "page" {
		return "/admin/posts/new?type=page"
	}
	return "/admin/posts/new"
}

// Href links to this list filtered by status, at page n.
func (l PostList) Href(status string, n int) string {
	v := url.Values{}
	if status != "" {
		v.Set("status", status)
	}
	if n > 1 {
		v.Set("page", strconv.Itoa(n))
	}
	if len(v) == 0 {
		return l.Base()
	}
	return l.Base() + "?" + v.Encode()
}

var statusFilters = []struct{ Key, Label string }{
	{"", "All"},
	{"draft", "Drafts"},
	{"scheduled", "Scheduled"},
	{"published", "Published"},
}

templ Posts(p Page, l PostList) {
	@Shell(p) {
		@PageHeader(p.Title) {
			<a
				href={ templ.SafeURL(l.NewHref()) }
				class="rounded-md bg-vermilion px-3 py-2 text-sm font-medium text-white hover:bg-vermilion-dark"
			>New { l.Type }</a>
		}
		<nav class="mb-4 flex flex-wrap gap-1" aria-label="Filter by status">
			for _, f := range statusFilters {
				if f.Key == l.Status {
					<a
						href={ templ.SafeURL(l.Href(f.Key, 1)) }
						aria-current="page"
						class="rounded-md bg-ink-100 px-3 py-1.5 text-sm font-medium"
					>{ f.Label }</a>
				} else {
					<a
						href={ templ.SafeURL(l.Href(f.Key, 1)) }
						class="rounded-md px-3 py-1.5 text-sm text-ink-600 hover:bg-ink-100 hover:text-ink-900"
					>{ f.Label }</a>
				}
			}
		</nav>
		if len(l.Rows) == 0 {
			<p class="rounded-lg border border-ink-200 bg-white p-8 text-ink-600">
				Nothing here yet. <a href={ templ.SafeURL(l.NewHref()) } class="text-vermilion underline underline-offset-2">Write one</a>.
			</p>
		} else {
			<div class="overflow-x-auto rounded-lg border border-ink-200 bg-white">
				<table class="w-full text-left text-sm">
					<thead class="border-b border-ink-200 text-xs uppercase tracking-wide text-ink-400">
						<tr>
							<th scope="col" class="px-4 py-3 font-medium">Title</th>
							<th scope="col" class="px-4 py-3 font-medium">Status</th>
							<th scope="col" class="px-4 py-3 font-medium">Author</th>
							<th scope="col" class="px-4 py-3 font-medium">Date</th>
							<th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, row := range l.Rows {
							<tr class="border-b border-ink-100 last:border-b-0">
								<td class="px-4 py-3">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/posts/%d", row.ID)) }
										class="font-medium hover:text-vermilion"
									>{ row.Title }</a>
									<span class="block truncate text-xs text-ink-400">/{ row.Slug }</span>
								</td>
								<td class="px-4 py-3">
									@statusBadge(row.Status)
								</td>
								<td class="px-4 py-3 text-ink-600">{ row.Author }</td>
								<td class="px-4 py-3 text-ink-600">
									<time datetime={ row.At.Format(time.RFC3339) }>{ row.At.Format("2 Jan 2006") }</time>
								</td>
								<td class="px-4 py-3 text-right">
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/posts/%d/delete", row.ID)) }>
										<button
											type="submit"
											class="text-xs text-ink-400 underline underline-offset-2 hover:text-vermilion"
											onclick="return confirm('Delete this permanently?')"
										>Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			@pager(l)
		}
	}
}

templ statusBadge(status string) {
	switch status {
		case "published":
			<span class="rounded-full bg-ink-100 px-2 py-0.5 text-xs font-medium text-ink-800">Published</span>
		case "scheduled":
			<span class="rounded-full bg-vermilion/10 px-2 py-0.5 text-xs font-medium text-vermilion-dark">Scheduled</span>
		default:
			<span class="rounded-full bg-ink-100 px-2 py-0.5 text-xs font-medium text-ink-600">Draft</span>
	}
}

templ pager(l PostList) {
	if l.Pages > 1 {
		<nav class="mt-4 flex items-center justify-between text-sm" aria-label="Pagination">
			if l.Page > 1 {
				<a href={ templ.SafeURL(l.Href(l.Status, l.Page-1)) } class="text-ink-600 hover:text-vermilion">← Newer</a>
			} else {
				<span></span>
			}
			<span class="text-ink-400">Page { strconv.Itoa(l.Page) } of { strconv.Itoa(l.Pages) }</span>
			if l.Page < l.Pages {
				<a href={ templ.SafeURL(l.Href(l.Status, l.Page+1)) } class="text-ink-600 hover:text-vermilion">Older →</a>
			} else {
				<span></span>
			}
		</nav>
	}
}
