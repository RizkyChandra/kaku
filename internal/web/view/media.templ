package view

import (
	"fmt"

	"github.com/RizkyChandra/kaku/internal/db"
)

// MediaList is what the media screen needs beyond the page chrome.
type MediaList struct {
	Items      []db.Medium
	Page       int
	Pages      int
	CanDelete  bool
	Configured bool // false when no S3 bucket is set up, so uploads are off
}

templ Media(p Page, m MediaList) {
	@Shell(p) {
		@PageHeader("Media")
		if m.Configured {
			<form
				class="mb-8 rounded-lg border border-dashed border-ink-200 bg-white p-6"
				hx-post="/admin/media"
				hx-encoding="multipart/form-data"
				hx-target="#grid"
				hx-swap="afterbegin"
				hx-indicator="#uploading"
			>
				<label for="file" class="block text-sm font-medium">Upload an image</label>
				<p class="mt-1 text-sm text-ink-400">PNG, JPEG, GIF or WebP, up to 10 MB.</p>
				<div class="mt-3 flex flex-wrap items-center gap-3">
					<input
						id="file"
						name="file"
						type="file"
						required
						accept="image/png,image/jpeg,image/gif,image/webp"
						class="min-w-0 flex-1 text-sm text-ink-600 file:mr-3 file:rounded-md file:border-0 file:bg-ink-100 file:px-3 file:py-2 file:text-sm file:font-medium hover:file:bg-ink-200"
					/>
					<button type="submit" class="rounded-md bg-vermilion px-3 py-2 text-sm font-medium text-white hover:bg-vermilion-dark">Upload</button>
					<span id="uploading" class="htmx-indicator text-sm text-ink-400" role="status">Uploading&hellip;</span>
				</div>
			</form>
		} else {
			<p class="mb-8 rounded-lg border border-ink-200 bg-white px-4 py-3 text-sm text-ink-600">
				Uploads are off: no object storage is configured. Set
				<code class="rounded bg-ink-100 px-1 py-0.5">KAKU_S3_BUCKET</code> and restart to turn them on.
			</p>
		}
		<div id="grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
			// only:block hides this again as soon as an upload is swapped in.
			<p class="col-span-full hidden text-ink-400 only:block">Nothing uploaded yet.</p>
			for _, item := range m.Items {
				@MediaTile(item, m.CanDelete)
			}
		</div>
		if m.Pages > 1 {
			<nav class="mt-8 flex items-center justify-between text-sm" aria-label="Pagination">
				if m.Page > 1 {
					<a href={ fmt.Sprintf("/admin/media?page=%d", m.Page-1) } class="text-ink-600 underline underline-offset-2 hover:text-vermilion">Newer</a>
				} else {
					<span></span>
				}
				<span class="text-ink-400">Page { fmt.Sprint(m.Page) } of { fmt.Sprint(m.Pages) }</span>
				if m.Page < m.Pages {
					<a href={ fmt.Sprintf("/admin/media?page=%d", m.Page+1) } class="text-ink-600 underline underline-offset-2 hover:text-vermilion">Older</a>
				} else {
					<span></span>
				}
			</nav>
		}
	}
}

// MediaTile is also served on its own as the htmx fragment for a new upload.
templ MediaTile(m db.Medium, canDelete bool) {
	<figure id={ fmt.Sprintf("media-%d", m.ID) } class="overflow-hidden rounded-lg border border-ink-200 bg-white">
		<img src={ m.Url } alt={ m.Filename } loading="lazy" class="aspect-square w-full bg-ink-100 object-cover"/>
		<figcaption class="p-3">
			<p class="truncate text-sm" title={ m.Filename }>{ m.Filename }</p>
			<div class="mt-2 flex items-center gap-3 text-xs">
				<button
					type="button"
					data-url={ m.Url }
					aria-label={ fmt.Sprintf("Copy the URL of %s", m.Filename) }
					onclick="navigator.clipboard.writeText(this.dataset.url); this.textContent = 'Copied'"
					class="text-ink-600 underline underline-offset-2 hover:text-vermilion"
				>Copy URL</button>
				if canDelete {
					<button
						type="button"
						aria-label={ fmt.Sprintf("Delete %s", m.Filename) }
						hx-post={ fmt.Sprintf("/admin/media/%d/delete", m.ID) }
						hx-target={ fmt.Sprintf("#media-%d", m.ID) }
						hx-swap="outerHTML"
						hx-confirm={ fmt.Sprintf("Delete %s? Posts using it will show a broken image.", m.Filename) }
						class="text-ink-400 underline underline-offset-2 hover:text-vermilion"
					>Delete</button>
				}
			</div>
		</figcaption>
	</figure>
}
