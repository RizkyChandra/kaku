package view

import (
	"fmt"

	"github.com/RizkyChandra/kaku/internal/db"
	"github.com/RizkyChandra/kaku/internal/i18n"
)

// MediaList is what the media screen needs beyond the page chrome.
type MediaList struct {
	Items      []db.Medium
	Page       int
	Pages      int
	CanDelete  bool
	Configured bool // false when no S3 bucket is set up, so uploads are off
}

templ Media(p Page, m MediaList) {
	@Shell(p) {
		@PageHeader(i18n.T(ctx, "media.title"))
		if m.Configured {
			<form
				class="mb-8 rounded-lg border border-dashed border-ink-200 bg-white p-6"
				hx-post="/admin/media"
				hx-encoding="multipart/form-data"
				hx-target="#grid"
				hx-swap="afterbegin"
				hx-indicator="#uploading"
			>
				<label for="file" class="block text-sm font-medium">{ i18n.T(ctx, "media.upload.label") }</label>
				<p class="mt-1 text-sm text-ink-400">{ i18n.T(ctx, "media.upload.hint") }</p>
				<div class="mt-3 flex flex-wrap items-center gap-3">
					<input
						id="file"
						name="file"
						type="file"
						required
						accept="image/png,image/jpeg,image/gif,image/webp"
						class="min-w-0 flex-1 text-sm text-ink-600 file:mr-3 file:rounded-md file:border-0 file:bg-ink-100 file:px-3 file:py-2 file:text-sm file:font-medium hover:file:bg-ink-200"
					/>
					<button type="submit" class="rounded-md bg-vermilion px-3 py-2 text-sm font-medium text-white hover:bg-vermilion-dark">{ i18n.T(ctx, "media.upload.button") }</button>
					<span id="uploading" class="htmx-indicator text-sm text-ink-400" role="status">{ i18n.T(ctx, "media.upload.progress") }</span>
				</div>
			</form>
		} else {
			// Two keys, not one: the bucket variable sits mid-sentence and word
			// order around it differs by language.
			<p class="mb-8 rounded-lg border border-ink-200 bg-white px-4 py-3 text-sm text-ink-600">
				{ i18n.T(ctx, "media.disabled.before") }
				<code class="rounded bg-ink-100 px-1 py-0.5">KAKU_S3_BUCKET</code>
				{ i18n.T(ctx, "media.disabled.after") }
			</p>
		}
		<div id="grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
			// only:block hides this again as soon as an upload is swapped in.
			<p class="col-span-full hidden text-ink-400 only:block">{ i18n.T(ctx, "media.empty") }</p>
			for _, item := range m.Items {
				@MediaTile(item, m.CanDelete)
			}
		</div>
		if m.Pages > 1 {
			<nav class="mt-8 flex items-center justify-between text-sm" aria-label={ i18n.T(ctx, "media.pagination") }>
				if m.Page > 1 {
					<a href={ fmt.Sprintf("/admin/media?page=%d", m.Page-1) } class="text-ink-600 underline underline-offset-2 hover:text-vermilion">{ i18n.T(ctx, "media.newer") }</a>
				} else {
					<span></span>
				}
				<span class="text-ink-400">{ i18n.T(ctx, "media.pageOf", m.Page, m.Pages) }</span>
				if m.Page < m.Pages {
					<a href={ fmt.Sprintf("/admin/media?page=%d", m.Page+1) } class="text-ink-600 underline underline-offset-2 hover:text-vermilion">{ i18n.T(ctx, "media.older") }</a>
				} else {
					<span></span>
				}
			</nav>
		}
	}
}

// mediaAltText is what the tile's own img says. An untyped alt falls back to
// the filename: a screen reader announcing "cat-photo.png" is poor, but a
// missing alt attribute makes the image invisible, which is worse.
func mediaAltText(m db.Medium) string {
	if m.Alt != "" {
		return m.Alt
	}
	return m.Filename
}

// MediaTile is also served on its own as the htmx fragment for a new upload
// and after a caption edit.
templ MediaTile(m db.Medium, canDelete bool) {
	<figure id={ fmt.Sprintf("media-%d", m.ID) } class="overflow-hidden rounded-lg border border-ink-200 bg-white">
		// Fixed square tiles with explicit width/height and object-cover keep
		// the browser from laying out and painting at full resolution, and
		// decoding off the main thread keeps the grid scrollable. It does NOT
		// shrink the download: a 4 MB photo is still 4 MB on the wire. Real
		// thumbnails need a resize at upload time writing a second object; that
		// is the upgrade path, and it is not this change.
		<img
			src={ m.Url }
			alt={ mediaAltText(m) }
			width="400"
			height="400"
			loading="lazy"
			decoding="async"
			class="aspect-square w-full bg-ink-100 object-cover"
		/>
		<figcaption class="p-3">
			<p class="truncate text-sm" title={ m.Filename }>{ m.Filename }</p>
			<form
				class="mt-2"
				hx-post={ fmt.Sprintf("/admin/media/%d/alt", m.ID) }
				hx-target={ fmt.Sprintf("#media-%d", m.ID) }
				hx-swap="outerHTML"
			>
				<label for={ fmt.Sprintf("alt-%d", m.ID) } class="block text-xs text-ink-400">{ i18n.T(ctx, "media.alt.label") }</label>
				<div class="mt-1 flex gap-2">
					<input
						id={ fmt.Sprintf("alt-%d", m.ID) }
						name="alt"
						value={ m.Alt }
						maxlength="300"
						placeholder={ i18n.T(ctx, "media.alt.placeholder") }
						class="min-w-0 flex-1 rounded-md border border-ink-200 px-2 py-1 text-xs"
					/>
					<button
						type="submit"
						aria-label={ i18n.T(ctx, "media.alt.aria", m.Filename) }
						class="rounded-md bg-ink-100 px-2 py-1 text-xs font-medium hover:bg-ink-200"
					>{ i18n.T(ctx, "media.alt.save") }</button>
				</div>
			</form>
			<div class="mt-2 flex items-center gap-3 text-xs">
				// The confirmation word rides in on a data attribute: put it in the
				// JS string literal instead and a translation with an apostrophe
				// ends the literal early.
				<button
					type="button"
					data-md={ fmt.Sprintf("![%s](%s)", mediaAltText(m), m.Url) }
					data-copied={ i18n.T(ctx, "media.copied") }
					aria-label={ i18n.T(ctx, "media.copyMarkdown.aria", m.Filename) }
					onclick="navigator.clipboard.writeText(this.dataset.md); this.textContent = this.dataset.copied"
					class="text-ink-600 underline underline-offset-2 hover:text-vermilion"
				>{ i18n.T(ctx, "media.copyMarkdown") }</button>
				<button
					type="button"
					data-url={ m.Url }
					data-copied={ i18n.T(ctx, "media.copied") }
					aria-label={ i18n.T(ctx, "media.copyUrl.aria", m.Filename) }
					onclick="navigator.clipboard.writeText(this.dataset.url); this.textContent = this.dataset.copied"
					class="text-ink-600 underline underline-offset-2 hover:text-vermilion"
				>{ i18n.T(ctx, "media.copyUrl") }</button>
				if canDelete {
					<button
						type="button"
						aria-label={ i18n.T(ctx, "media.delete.aria", m.Filename) }
						hx-post={ fmt.Sprintf("/admin/media/%d/delete", m.ID) }
						hx-target={ fmt.Sprintf("#media-%d", m.ID) }
						hx-swap="outerHTML"
						hx-confirm={ i18n.T(ctx, "media.delete.confirm", m.Filename) }
						class="text-ink-400 underline underline-offset-2 hover:text-vermilion"
					>{ i18n.T(ctx, "media.delete") }</button>
				}
			</div>
		</figcaption>
	</figure>
}
