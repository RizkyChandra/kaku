package view

import (
	"strconv"

	"github.com/RizkyChandra/kaku/internal/db"
)

func tagPath(id int64, suffix string) string {
	return "/admin/tags/" + strconv.FormatInt(id, 10) + suffix
}

// tagRowPath carries the post count along with the row fragment routes: no
// single-tag query has it, and it is display-only, so the row hands it back
// instead of earning a query per edit. See tagLookup.
func tagRowPath(t db.ListTagsRow, suffix string) string {
	return tagPath(t.ID, suffix) + "?posts=" + strconv.FormatInt(t.PostCount, 10)
}

// Tags is the whole tag screen: a create form above the table. Editing happens
// in place, one row at a time.
templ Tags(p Page, tags []db.ListTagsRow, page, pages int, errMsg string) {
	@Shell(p) {
		@PageHeader("Tags")
		<form method="post" action="/admin/tags" class="mb-8 rounded-lg border border-ink-200 bg-white p-6">
			if errMsg != "" {
				<p class="mb-4 rounded-md bg-vermilion/10 px-3 py-2 text-sm text-vermilion-dark" role="alert">{ errMsg }</p>
			}
			<div class="grid gap-4 sm:grid-cols-3">
				<div>
					<label class="block text-sm font-medium" for="name">Name</label>
					<input id="name" name="name" required class="mt-1 w-full rounded-md border border-ink-200 px-3 py-2 focus:border-vermilion focus:outline-none"/>
				</div>
				<div>
					<label class="block text-sm font-medium" for="slug">Slug</label>
					<input id="slug" name="slug" placeholder="from the name" class="mt-1 w-full rounded-md border border-ink-200 px-3 py-2 focus:border-vermilion focus:outline-none"/>
				</div>
				<div>
					<label class="block text-sm font-medium" for="description">Description</label>
					<input id="description" name="description" class="mt-1 w-full rounded-md border border-ink-200 px-3 py-2 focus:border-vermilion focus:outline-none"/>
				</div>
			</div>
			<button type="submit" class="mt-4 rounded-md bg-vermilion px-3 py-2 text-sm font-medium text-white hover:bg-vermilion-dark">Add tag</button>
		</form>
		<div class="overflow-hidden rounded-lg border border-ink-200 bg-white">
			<table class="w-full text-left text-sm">
				<thead class="border-b border-ink-200 text-xs uppercase tracking-wide text-ink-400">
					<tr>
						<th scope="col" class="px-4 py-3 font-medium">Name</th>
						<th scope="col" class="px-4 py-3 font-medium">Slug</th>
						<th scope="col" class="px-4 py-3 font-medium">Posts</th>
						<th scope="col" class="px-4 py-3 font-medium"><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					if len(tags) == 0 {
						<tr><td colspan="4" class="px-4 py-6 text-ink-400">No tags yet.</td></tr>
					}
					for _, t := range tags {
						@TagRow(t)
					}
				</tbody>
			</table>
		</div>
		@listPager("/admin/tags", page, pages)
	}
}

// TagRow is both a row of the table and the htmx swap target for editing it.
templ TagRow(t db.ListTagsRow) {
	<tr class="border-b border-ink-100 last:border-0">
		<td class="px-4 py-3 font-medium">{ t.Name }</td>
		<td class="px-4 py-3 text-ink-600"><code>{ t.Slug }</code></td>
		<td class="px-4 py-3 text-ink-600">{ strconv.FormatInt(t.PostCount, 10) }</td>
		<td class="px-4 py-3 text-right">
			<button
				type="button"
				hx-get={ tagRowPath(t, "/edit") }
				hx-target="closest tr"
				hx-swap="outerHTML"
				class="text-ink-600 underline underline-offset-2 hover:text-vermilion"
			>Edit<span class="sr-only"> { t.Name }</span></button>
			<button
				type="button"
				hx-post={ tagPath(t.ID, "/delete") }
				hx-target="closest tr"
				hx-swap="outerHTML"
				hx-confirm={ "Delete " + t.Name + "? Posts tagged with it keep their other tags." }
				class="ml-4 text-ink-600 underline underline-offset-2 hover:text-vermilion"
			>Delete<span class="sr-only"> { t.Name }</span></button>
		</td>
	</tr>
}

templ TagEditRow(t db.ListTagsRow, errMsg string) {
	<tr class="border-b border-ink-100 bg-ink-50 last:border-0">
		<td colspan="4" class="px-4 py-3">
			if errMsg != "" {
				<p class="mb-3 rounded-md bg-vermilion/10 px-3 py-2 text-sm text-vermilion-dark" role="alert">{ errMsg }</p>
			}
			<form hx-post={ tagRowPath(t, "") } hx-target="closest tr" hx-swap="outerHTML" class="flex flex-wrap items-end gap-3">
				<div>
					<label class="block text-xs font-medium" for={ "name-" + strconv.FormatInt(t.ID, 10) }>Name</label>
					<input
						id={ "name-" + strconv.FormatInt(t.ID, 10) }
						name="name"
						value={ t.Name }
						required
						class="mt-1 rounded-md border border-ink-200 px-2 py-1 focus:border-vermilion focus:outline-none"
					/>
				</div>
				<div>
					<label class="block text-xs font-medium" for={ "slug-" + strconv.FormatInt(t.ID, 10) }>Slug</label>
					<input
						id={ "slug-" + strconv.FormatInt(t.ID, 10) }
						name="slug"
						value={ t.Slug }
						class="mt-1 rounded-md border border-ink-200 px-2 py-1 focus:border-vermilion focus:outline-none"
					/>
				</div>
				<div class="grow">
					<label class="block text-xs font-medium" for={ "description-" + strconv.FormatInt(t.ID, 10) }>Description</label>
					<input
						id={ "description-" + strconv.FormatInt(t.ID, 10) }
						name="description"
						value={ t.Description }
						class="mt-1 w-full rounded-md border border-ink-200 px-2 py-1 focus:border-vermilion focus:outline-none"
					/>
				</div>
				<button type="submit" class="rounded-md bg-vermilion px-3 py-1.5 text-sm font-medium text-white hover:bg-vermilion-dark">Save tag</button>
				<button
					type="button"
					hx-get={ tagRowPath(t, "") }
					hx-target="closest tr"
					hx-swap="outerHTML"
					class="px-1 py-1.5 text-sm text-ink-600 underline underline-offset-2 hover:text-vermilion"
				>Cancel</button>
			</form>
		</td>
	</tr>
}
